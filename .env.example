# Copia a `.env` y ajusta. `.env` no se sube al repositorio.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Superusuario del contenedor: solo crea el rol de la app (un superusuario ignora RLS).
POSTGRES_SUPERUSER_PASSWORD=cambia-esto-admin
# Rol y base que usa la aplicación (sin superusuario).
POSTGRES_DB=lushbeauty
POSTGRES_USER=lushbeauty
POSTGRES_PASSWORD=cambia-esto-app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
